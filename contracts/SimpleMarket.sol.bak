// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

import {IERC721} from "@openzeppelin/contracts/token/ERC721/IERC721.sol";
import {IERC165} from "@openzeppelin/contracts/utils/introspection/IERC165.sol";
import {IERC2981} from "@openzeppelin/contracts/interfaces/IERC2981.sol";
import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

/**
 * @title SimpleMarket —— 一个最简 NFT 市场（挂单 / 购买 / 撤单 / 手续费 / 版税 / 提现）
 *
 * ============================================================================
 * 一、这个合约在做什么
 * ============================================================================
 *
 * 它解决一个撮合问题：卖家想把某枚 NFT 卖 X ETH，买家愿意付，双方互不信任。
 * 市场合约充当可信中间人，保证「付钱」和「交货」要么同时发生，要么都不发生。
 *
 * 注意它【不持有】NFT 和 ETH（手续费除外）：
 *   · NFT 成交时才从卖家直接转给买家，市场只是被授权代为操作
 *   · ETH 也是从买家直接打到卖家，市场只是过一手计算
 * 这叫【授权式（approval-based）】，是 OpenSea Seaport、Blur 等主流市场采用的方式。
 *
 * 另一种做法是【托管式（escrow）】：挂单时把 NFT 转入市场合约保管。
 * 为什么不这么做？
 *   1. 资产集中：合约里堆着大量 NFT，一旦合约出事就是系统性损失
 *   2. 浪费 gas：挂单一次转账、撤单又一次转账
 *   3. 挂单期间 NFT 不在自己手上，卖家的其他操作（如抵押）会受影响
 * 授权式只在成交瞬间动一次 NFT，gas 和风险都更低。
 *
 * ============================================================================
 * 二、挂单的本质 = 一次 approve
 * ============================================================================
 *
 * 卖家调用 list(nft, tokenId, price) 之前，必须先对市场合约授权：
 *
 *   nft.approve(marketAddress, tokenId)              —— 单枚授权（推荐）
 *   或 nft.setApprovalForAll(marketAddress, true)    —— 全量授权（市场常用，风险高）
 *
 * 这就是你上一轮亲手练过的东西在市场里的真实用途。
 * 顺带复习风险：市场页面让你签的 setApprovalForAll，一旦签了，
 * 该市场合约（或钓鱼合约）随时能转走你该系列的全部 NFT，且授权不会自动失效。
 * 所以 list() 里我们硬性校验授权状态，没授权直接拒绝挂单。
 *
 * ============================================================================
 * 三、本合约涉及的核心安全考点（写市场合约最容易出事的地方）
 * ============================================================================
 *
 * 1) 重入攻击（Reentrancy）—— 本合约用两道防线
 *    危险写法：先给卖家转 ETH，再转 NFT。
 *    如果卖家是恶意合约，它收到 ETH 时会在 fallback 里回调 buy()，
 *    此时挂单状态还没更新，它会再买一次……直到把钱掏空。
 *
 *    防线 A：Checks-Effects-Interactions（检查-生效-交互）
 *      先把挂单标记失效、先累计手续费（改状态），
 *      再做所有外部调用（转 NFT、转 ETH）。
 *      这样重入进来时状态已经是「已售出」，第二次 buy 在第一行检查就失败。
 *
 *    防线 B：ReentrancyGuard 的 nonReentrant 修饰符
 *      互斥锁，同一笔交易内不允许嵌套进入。
 *
 *    两道都用 —— 这是纵深防御，安全领域不信任单一机制。
 *
 * 2) Pull Payment（拉取式付款）而不是 Push
 *    平台手续费不直接转给 owner，而是累加到 accumulatedFees，
 *    由 owner 主动调用 withdrawFees 提取。
 *    原因：如果 owner 是某个合约且它拒绝收款（或它的 fallback 很耗 gas），
 *    直接转账会导致【所有人的交易都失败】—— 一个人拖垮整个市场。
 *    这是经典的「拒绝服务」陷阱。
 *
 * 3) 陈旧挂单（Stale Listing）
 *    卖家挂单后，可能把 NFT 转走了，也可能撤销了对市场的授权。
 *    此时挂单记录还在，但已经无法成交。
 *    所以 buy() 要重新校验当前持有者是否仍是挂单时的卖家。
 *
 * 4) 费用计算用基点（basis points）
 *    feeBps：10000 = 100%，250 = 2.5%。整数运算，避免浮点。
 *    并设 10% 的硬上限，防止 owner 手滑（或作恶）把手续费设成 100%。
 *
 * 5) 多余的 ETH 要退还
 *    买家可能多付（前端估算偏差、或同时有多人抢同一单）。
 *    多付的部分必须退回去，不能默默吞掉。
 *
 * 6) 版税（EIP-2981）的三条铁律 —— 本轮新增，见下一节详述
 *    a. 用 ERC165 做能力检测，不支持就跳过，绝不让老 NFT 卖不掉
 *    b. 版税与手续费一样走 Pull Payment，绝不在 buy() 里直接 push 给创作者
 *    c. 平台费 + 版税 + 卖家实得 三者之和【恒等于】成交价，
 *       整数除法产生的 1~2 wei 余数明确归卖家，合约里不留取不出的钱
 *
 * ============================================================================
 * 三点五、版税（EIP-2981）在市场侧的实现要点
 * ============================================================================
 *
 * 一笔成交价 price 的完整去向：
 *
 *        price
 *          ├── 平台手续费 fee      = price * feeBps / 10000       → accumulatedFees（owner 提）
 *          ├── 创作者版税 royalty  = price * royaltyBps / 10000   → pendingRoyalties（创作者提）
 *          └── 卖家实得 proceeds   = price - fee - royalty        → 立刻打给卖家
 *
 * 四个必须做对的细节：
 *
 *   1) 顺序：先算 fee，再算 royalty，剩下的全是卖家的。
 *      这样 royalty 再大也不会让卖家那一份算成负数（下溢 panic 0x11）。
 *
 *   2) 用 ERC165 检测，而不是无脑调用。
 *      if (IERC165(nft).supportsInterface(0x2a55205a)) { (receiver, amount) = royaltyInfo(...) }
 *      早期 NFT（CryptoPunks、2021 年前的合集）没有 royaltyInfo，
 *      直接调用会 revert，导致这些 NFT 在本市场完全无法成交。
 *      检测失败 → royalty = 0，交易照常进行，这叫【优雅降级】。
 *
 *   3) Pull Payment 而非 push。
 *      若在 buy() 里直接把版税转给 receiver：
 *        · receiver 是拒收 ETH 的合约 → 整笔成交 revert（DoS，卖家被连坐）
 *        · receiver 的 fallback 很耗 gas → 买家 gas 被吃光
 *        · receiver 在 fallback 里做手脚 → 多一个重入面
 *      所以版税只累加到 pendingRoyalties[receiver]，由 receiver 自己来 withdrawRoyalties()。
 *      它拒收，只影响它自己提现，不影响市场成交。
 *
 *   4) 恶意 NFT 合约的防御。
 *      royaltyInfo 是 NFT 合约自己实现的，它可以返回：
 *        · 一个黑洞地址（钱取不出来）→ 我们拦不住，也不该拦，这是创作者自己设的
 *        · 一个超过成交价的金额（10000 bps = 100%，甚至写死返回 type(uint256).max）
 *          → 不处理的话 price - fee - royalty 会下溢 panic，该 NFT 永久无法成交（DoS）
 *      我们的处理：把版税【钳制】在 price - fee 以内，钱全给创作者、卖家拿 0，
 *      至少保证交易能进行、且三方之和仍等于 price。
 * ============================================================================
 * 四、本合约 simplification（为教学做的简化，真实市场要复杂得多）
 * ============================================================================
 *   · 只支持 ETH 计价，不支持 ERC20（如 WETH / USDC）
 *   · 同一枚 NFT 同时只能有一个挂单
 *   · 没有议价（offer / 出价）功能
 *   · 没有签名挂单（Seaport 用 EIP-712 签名实现零 gas 挂单）
 *   · 手续费 + 版税都是【平台自愿】的：本合约选择尊重 EIP-2981，
 *     但链上没有强制力（Blur 就曾以"可选版税"抢市场），这是商业选择不是技术问题
 * ============================================================================
 */
contract SimpleMarket is Ownable, ReentrancyGuard {
    // ========================================================================
    // 数据结构
    // ========================================================================

    /// @notice 一条挂单记录
    /// @param seller 卖家地址
    /// @param price  售价（wei）
    /// @param active 是否有效。撤单/成交后置 false，而不是删除记录
    ///               （保留历史记录便于链下索引，也能省 gas：删除 mapping 的退款收益有限）
    struct Listing {
        address seller;
        uint256 price;
        bool active;
    }

    // ========================================================================
    // 状态变量
    // ========================================================================

    /// @notice 平台手续费（基点）：10000 = 100%，250 = 2.5%
    uint256 public feeBps;

    /// @notice 累计待提取的手续费（单位 wei）
    uint256 public accumulatedFees;

    /// @notice 待提取的版税：版税接收者 => 累计金额（wei）
    ///         与手续费一样是 Pull Payment 设计，见 _splitProceeds 的说明
    mapping(address => uint256) public pendingRoyalties;

    /// @notice 手续费硬上限 10%，防止 owner 设成离谱的值
    uint256 public constant MAX_FEE_BPS = 1000;

    /// @notice 基点分母
    uint256 private constant BPS_DENOMINATOR = 10_000;

    /// @notice EIP-2981 的 interfaceId（0x2a55205a）
    ///         硬编码常量只是为了省一次外部调用；语义上等价于
    ///         type(IERC2981).interfaceId，测试里会断言两者一致
    bytes4 private constant INTERFACE_ID_ERC2981 = 0x2a55205a;

    /// @notice 挂单表：NFT 合约地址 => tokenId => 挂单
    ///         这样设计使得一个市场可以服务任意多个 NFT 合集
    mapping(address => mapping(uint256 => Listing)) private _listings;

    // ========================================================================
    // 事件（前端与市场活动流全部依赖它们）
    // ========================================================================

    event Listed(address indexed nftContract, uint256 indexed tokenId, address indexed seller, uint256 price);
    event PriceUpdated(address indexed nftContract, uint256 indexed tokenId, uint256 oldPrice, uint256 newPrice);
    event Canceled(address indexed nftContract, uint256 indexed tokenId, address indexed seller);
    event Sold(
        address indexed nftContract,
        uint256 indexed tokenId,
        address indexed seller,
        address buyer,
        uint256 price,
        uint256 fee
    );
    event FeeBpsUpdated(uint256 oldFeeBps, uint256 newFeeBps);
    event FeesWithdrawn(address indexed to, uint256 amount);

    /// @notice 一笔成交产生了版税。注意：这是【入账】事件，不是"已打款"——
    ///         钱此刻仍在市场合约里，等 receiver 调 withdrawRoyalties() 才真正转走
    event RoyaltyPaid(
        address indexed nftContract,
        uint256 indexed tokenId,
        address indexed receiver,
        uint256 amount
    );

    /// @notice 版税接收者成功提走版税
    event RoyaltyWithdrawn(address indexed receiver, uint256 amount);

    // ========================================================================
    // 自定义错误
    // ========================================================================

    error PriceMustBeGreaterThanZero();
    error NotTokenOwner();
    error MarketNotApproved();
    error AlreadyListed();
    error NotListed();
    error NotSeller();
    error InsufficientPayment(uint256 sent, uint256 required);
    error StaleListing(address currentOwner, address listingSeller);
    error FeeTooHigh(uint256 provided, uint256 max);
    error EthTransferFailed();
    error NothingToWithdraw();
    error ZeroAddress();
    error RoyaltyTransferFailed();

    // ========================================================================
    // 构造函数
    // ========================================================================

    /**
     * @param initialOwner 市场 owner（可提取手续费、可调费率）
     * @param feeBps_      初始手续费（基点）
     */
    constructor(address initialOwner, uint256 feeBps_) Ownable(initialOwner) {
        _setFeeBps(feeBps_);
    }

    // ========================================================================
    // 卖家侧：挂单 / 改价 / 撤单
    // ========================================================================

    /**
     * @notice 挂单出售一枚 NFT
     * @param nftContract NFT 合约地址
     * @param tokenId     要卖的 NFT 编号
     * @param price       售价（wei）
     *
     * 前置条件（三个都要满足，否则 revert）：
     *   1. msg.sender 是当前持有者
     *   2. 本市场合约已被授权操作这枚 NFT（approve 或 setApprovalForAll）
     *   3. 价格 > 0
     *
     * 注意：本函数【不转移】NFT，它只在链上记一条「我愿意以这个价卖」的记录。
     *      真正做到「钱货两清」的是 buy()。
     */
    function list(address nftContract, uint256 tokenId, uint256 price) external {
        if (price == 0) revert PriceMustBeGreaterThanZero();

        IERC721 nft = IERC721(nftContract);

        // 检查 1：调用者必须是持有者
        if (nft.ownerOf(tokenId) != msg.sender) revert NotTokenOwner();

        // 检查 2：市场必须已被授权，否则成交时转不动
        // getApproved 只覆盖单枚授权，还要看全量授权，两者满足其一即可
        bool approved = nft.getApproved(tokenId) == address(this) ||
            nft.isApprovedForAll(msg.sender, address(this));
        if (!approved) revert MarketNotApproved();

        // 检查 3：不能重复挂单（同一枚同时只能有一个有效挂单）
        if (_listings[nftContract][tokenId].active) revert AlreadyListed();

        _listings[nftContract][tokenId] = Listing({seller: msg.sender, price: price, active: true});

        emit Listed(nftContract, tokenId, msg.sender, price);
    }

    /**
     * @notice 修改挂单价格
     * @dev 只改价格，不重新校验授权与持有状态 —— 这是一处刻意的简化。
     *      真实市场里改价通常要求重新校验，否则可能出现「已转走 NFT 还能改价」的脏数据。
     *      成交时 buy() 会兜底校验持有者，所以不会造成资金损失。
     */
    function updatePrice(address nftContract, uint256 tokenId, uint256 newPrice) external {
        Listing storage listing = _listings[nftContract][tokenId];
        if (!listing.active) revert NotListed();
        if (listing.seller != msg.sender) revert NotSeller();
        if (newPrice == 0) revert PriceMustBeGreaterThanZero();

        uint256 oldPrice = listing.price;
        listing.price = newPrice;

        emit PriceUpdated(nftContract, tokenId, oldPrice, newPrice);
    }

    /**
     * @notice 撤销挂单
     * @dev 重要：撤单【不会】自动撤销你对市场的授权。
     *      链上授权还在，市场合约理论上仍能转走你的 NFT。
     *      要彻底收回权限，请自己调用：
     *        nft.approve(address(0), tokenId)              // 单枚
     *        nft.setApprovalForAll(market, false)          // 全量
     *      这正是上一轮练的重点：全量授权不会自动过期。
     */
    function cancel(address nftContract, uint256 tokenId) external {
        Listing storage listing = _listings[nftContract][tokenId];
        if (!listing.active) revert NotListed();
        if (listing.seller != msg.sender) revert NotSeller();

        listing.active = false;

        emit Canceled(nftContract, tokenId, msg.sender);
    }

    // ========================================================================
    // 买家侧：购买
    // ========================================================================

    /**
     * @notice 购买一枚已挂单的 NFT
     * @param nftContract NFT 合约地址
     * @param tokenId     要买的 NFT 编号
     *
     * 执行顺序严格遵循 Checks-Effects-Interactions：
     *   Checks      校验挂单有效、钱够、持有者没变
     *   Effects     立刻把挂单置为失效、累加手续费（先改状态！）
     *   Interactions 然后才做外部调用：转 NFT、付钱、退款
     *
     * 为什么顺序如此关键 —— 见上方「三、1) 重入攻击」。
     */
    function buy(address nftContract, uint256 tokenId) external payable nonReentrant {
        Listing storage listing = _listings[nftContract][tokenId];

        /* ---------------- Checks（检查） ---------------- */
        if (!listing.active) revert NotListed();
        if (msg.value < listing.price) {
            revert InsufficientPayment(msg.value, listing.price);
        }

        address seller = listing.seller;
        uint256 price = listing.price;

        // 防御陈旧挂单：卖家可能已经把 NFT 转走，或撤销了授权
        address currentOwner = IERC721(nftContract).ownerOf(tokenId);
        if (currentOwner != seller) {
            revert StaleListing(currentOwner, seller);
        }

        /* ---------------- Effects（改状态） ---------------- */
        // 先置失效再转账 —— 这样即使后面有重入，也进不到这里
        listing.active = false;

        // 三方分账：平台手续费 + 创作者版税 + 卖家实得，三者之和恒等于 price
        (uint256 fee, uint256 royalty, address royaltyReceiver, uint256 sellerProceeds) =
            _splitProceeds(nftContract, tokenId, price);

        if (fee > 0) {
            accumulatedFees += fee; // 累积起来等 owner 提取，不在这里直接转（Pull Payment）
        }

        if (royalty > 0) {
            // 版税同样只入账、不转账。receiver 拒收 ETH 时，只影响它自己提现，
            // 不会连累这笔成交失败（Push 写法下的经典 DoS 陷阱）
            pendingRoyalties[royaltyReceiver] += royalty;
            emit RoyaltyPaid(nftContract, tokenId, royaltyReceiver, royalty);
        }

        /* ---------------- Interactions（外部调用） ---------------- */

        // 1) 把 NFT 转给买家。用 safe 版本：如果买家是合约且不支持 NFT，整笔回滚
        IERC721(nftContract).safeTransferFrom(seller, msg.sender, tokenId);

        // 2) 给卖家打款。用 call 并检查返回值，不用 transfer（2300 gas 限制会误伤合约卖家）
        (bool ok, ) = payable(seller).call{value: sellerProceeds}("");
        if (!ok) revert EthTransferFailed();

        // 3) 多付的钱退给买家
        uint256 excess = msg.value - price;
        if (excess > 0) {
            (bool refundOk, ) = payable(msg.sender).call{value: excess}("");
            if (!refundOk) revert EthTransferFailed();
        }

        emit Sold(nftContract, tokenId, seller, msg.sender, price, fee);
    }

    // ========================================================================
    // 查询
    // ========================================================================

    /// @notice 查询一条挂单
    function getListing(
        address nftContract,
        uint256 tokenId
    ) external view returns (address seller, uint256 price, bool active) {
        Listing storage l = _listings[nftContract][tokenId];
        return (l.seller, l.price, l.active);
    }

    /**
     * @notice 计算某价格的手续费与卖家实得（前端展示用，纯函数不花 gas）
     */
    function quote(
        uint256 price
    ) external view returns (uint256 fee, uint256 sellerProceeds) {
        fee = (price * feeBps) / BPS_DENOMINATOR;
        sellerProceeds = price - fee;
    }

    // ========================================================================
    // 分账逻辑（手续费 + 版税 + 卖家实得）
    // ========================================================================

    /**
     * @dev 把成交价 price 拆成三份。buy() 与 quoteWithRoyalty() 共用它，
     *      保证"前端看到的预估"和"链上真实执行的"永远是同一套算法。
     *
     * 三条不变量（测试里逐条断言）：
     *   1. fee + royalty + sellerProceeds == price      一分钱不多、一分钱不少
     *   2. sellerProceeds >= 0                          绝不下溢
     *   3. 整数除法的余数（最多 2 wei）全部落进 sellerProceeds
     *
     * @return fee            平台手续费
     * @return royalty        创作者版税（不支持 2981 / 未设版税时为 0）
     * @return royaltyReceiver 版税收款方（无版税时为 address(0)）
     * @return sellerProceeds 卖家实得
     */
    function _splitProceeds(
        address nftContract,
        uint256 tokenId,
        uint256 price
    ) private view returns (uint256 fee, uint256 royalty, address royaltyReceiver, uint256 sellerProceeds) {
        // 平台手续费：price * feeBps / 10000（向下取整）
        fee = (price * feeBps) / BPS_DENOMINATOR;

        // 版税：先做 ERC165 能力检测，再查报价
        if (IERC165(nftContract).supportsInterface(INTERFACE_ID_ERC2981)) {
            (address receiver, uint256 amount) = IERC2981(nftContract).royaltyInfo(tokenId, price);

            // 只有"接收者有效 且 金额大于 0"才算版税。
            // 未设版税的合集会返回 (address(0), 0) —— 走 else 分支，交易照常
            if (receiver != address(0) && amount > 0) {
                // 版税上限 = 扣掉平台费后剩下的全部。
                // 没有这个钳制，恶意/配置失误的 NFT（100% 版税）会让下面的减法下溢，
                // 导致该 NFT 在本市场永远卖不掉（panic 0x11 无法被 try/catch 捕获）
                uint256 maxRoyalty = price - fee;
                if (amount > maxRoyalty) {
                    amount = maxRoyalty;
                }

                royalty = amount;
                royaltyReceiver = receiver;
            }
        }

        // 卖家拿剩下的全部（含取整余数）。royalty <= price - fee，所以不会下溢
        sellerProceeds = price - fee - royalty;
    }

    /**
     * @notice 前端专用：预估一笔成交的三方分账，纯 view 不花 gas
     * @param nftContract NFT 合约地址
     * @param tokenId     要买的 NFT 编号
     * @param price       假设的成交价（wei）
     */
    function quoteWithRoyalty(
        address nftContract,
        uint256 tokenId,
        uint256 price
    )
        external
        view
        returns (uint256 fee, uint256 royalty, address royaltyReceiver, uint256 sellerProceeds)
    {
        return _splitProceeds(nftContract, tokenId, price);
    }

    // ========================================================================
    // 版税收款方：提取
    // ========================================================================

    /**
     * @notice 提取属于 msg.sender 的版税（Pull Payment 的另一半）
     *
     * 与 withdrawFees 的两点不同：
     *   1. 没有 onlyOwner —— 谁被 NFT 指定为版税接收者，谁就能提自己的那一份
     *   2. 没有 ZeroAddress 校验 —— msg.sender 不可能是零地址，
     *      而允许"提到别的地址"反而会把别人的版税转走，所以只允许提到 msg.sender
     *
     * 顺序依旧是先改状态（清零）再转账，配合 nonReentrant 防重入。
     */
    function withdrawRoyalties() external nonReentrant {
        uint256 amount = pendingRoyalties[msg.sender];
        if (amount == 0) revert NothingToWithdraw();

        pendingRoyalties[msg.sender] = 0; // 先改状态

        (bool ok, ) = payable(msg.sender).call{value: amount}("");
        if (!ok) revert RoyaltyTransferFailed();

        emit RoyaltyWithdrawn(msg.sender, amount);
    }

    // ========================================================================
    // Owner 管理
    // ========================================================================

    /// @notice 调整手续费（受 MAX_FEE_BPS 上限约束）
    function setFeeBps(uint256 newFeeBps) external onlyOwner {
        _setFeeBps(newFeeBps);
    }

    /**
     * @notice 提取累计手续费
     * @param to 收款地址
     *
     * 这就是 Pull Payment：钱一直躺在合约里，owner 主动来取。
     * 对比直接 push 给 owner 的做法，它把「owner 收不收款」和「市场能不能正常成交」
     * 这两件事彻底解耦 —— 即使 owner 地址出问题，用户的买卖也不受影响。
     */
    function withdrawFees(address to) external onlyOwner nonReentrant {
        if (to == address(0)) revert ZeroAddress();
        uint256 amount = accumulatedFees;
        if (amount == 0) revert NothingToWithdraw();

        accumulatedFees = 0; // 先改状态再转账，防重入

        (bool ok, ) = payable(to).call{value: amount}("");
        if (!ok) revert EthTransferFailed();

        emit FeesWithdrawn(to, amount);
    }

    /// @dev 内部设置费率，带上限校验
    function _setFeeBps(uint256 newFeeBps) private {
        if (newFeeBps > MAX_FEE_BPS) revert FeeTooHigh(newFeeBps, MAX_FEE_BPS);
        uint256 old = feeBps;
        feeBps = newFeeBps;
        emit FeeBpsUpdated(old, newFeeBps);
    }

    /*
     * ==========================================================================
     * 【知识点】为什么用 call 而不是 transfer / send
     * ==========================================================================
     *   addr.transfer(x)   —— 固定转发 2300 gas，够发个日志，不够做任何逻辑
     *   addr.send(x)       —— 同 2300 gas，但失败不 revert，只返回 false（易被忽略）
     *   addr.call{value:x}("") —— 转发剩余全部 gas，返回 (bool, bytes)
     *
     * 2300 gas 的问题：如果收款方是合约（多签钱包、某些市场合约、Gnosis Safe），
     * 它的 fallback 稍微复杂一点就会 out of gas，导致整个交易失败。
     * 历史上多起因使用 transfer 导致资金卡死的案例。
     *
     * 当前最佳实践：用 call，然后【必须】检查返回值。
     * 至于 call 带来的重入风险，用 nonReentrant + 先改状态来防，而不是靠限制 gas。
     *
     * 同理，本合约转 NFT 用 safeTransferFrom 而不是 transferFrom：
     * 前者在接收方是合约时会校验它是否支持 NFT，防止资产被锁死。
     * 代价是多一次外部调用、gas 略高（你上一轮实测约 +5,500 gas）。
     * ==========================================================================
     */
}
